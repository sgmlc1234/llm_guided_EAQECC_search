\\n            fails += 1\\n            \\n        temp = max(0.01, temp * 0.999)\\n        if fails > 300:\\n            L = random_L()\\n            S = get_S(L)\\n            cur_obj = objective(E.evaluate(S))\\n            temp = 10.0\\n            fails = 0\\n\\n    return None\"\n}",
