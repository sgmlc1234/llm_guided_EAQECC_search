_obj = objective(new_res)\\n        \\n        delta = new_obj - cur\\n        if delta <= 0 or rng.random() < math.exp(-delta / temp):\\n            L, cur = new_L, new_obj\\n            fails = 0\\n        else:\\n            fails += 1\\n            if fails > 200:\\n                if E.incumbent is not None:\\n                    S_inc = E.incumbent\\n                    L = E.nullspace([E._J(v, n) for v in S_inc], 2 * n)\\n                    cur = objective(E.incumbent_parameters)\\n                else:\\n                    L = random_L()\\n                    S = get_S(L)\\n                    cur = objective(E.evaluate(S))\\n                fails = 0\\n                temp = 30.0\\n\\n    return None\"}",
