            "text": "{\"code\": \"import math\\nimport numpy as np\\n\\ndef search(target, max_evals):\\n    n, k, c = target[\\\"n\\\"], target[\\\"k\\\"], target[\\\"c\\\"]\\n    s = n - k + c\\n    len_L = 2 * n - s\\n\\n    def objective(res):\\n        if res.get(\\\"offending\\\") is None or res.get(\\\"c\\\") is None:\\n            return 10**9\\n        return 5000 * abs(res[\\\"c\\\"] - c) + res[\\\"offending\\\"]\\n\\n    def random_pauli():\\n        wt = int(rng.choice([1, 2, 3, n], p=[0.4, 0.3, 0.2, 0.1]))\\n        wt = min(wt, n)\\n        qubits = rng.choice(n, size=wt, replace=False)\\n        delta = 0\\n        for q in qubits:\\n            delta |= int(rng.integers(1, 4)) << (2 * int(q))\\n        return delta\\n\\n    def get_random_L():\\n        while True:\\n            candidate = []\\n            for _ in range(len_L):\\n                val = 0\\n                while val == 0:\\n                    val = int(rng.integers(1, 1 << (2 * n)))\\n                candidate.append(val)\\n            if len(E.gf2_basis(candidate)) == len_L:\\n                return candidate\\n\\n    L = get_random_L()\\n    S = E.nullspace([E._J(v, n) for v in L], 2 * n)\\n    cur = objective(E.evaluate(S))\\n    \\n    best_L = list(L)\\n    best_obj = cur\\n\\n    temp, fails = 30.0, 0\\n    while E.remaining:\\n        temp = max(0.1, temp * 0.995)\\n        candidate_L = list(L)\\n        mut_idx = int(rng.integers(len_L))\\n        \\n        # Row operations preserve the span and thus S, so they are free basis changes\\n        if rng.random() < 0.3:\\n            other_idx = (mut_idx + int(rng.integers(1, len_L))) % len_L\\n            candidate_L[mut_idx] ^= candidate_L[other_idx]\\n            if candidate_L[mut_idx] != 0 and len(E.gf2_basis(candidate_L)) == len_L:\\n                L = candidate_L\\n            continue\\n\\n        # Actual search space mutation (modifies the span of L)\\n        candidate_L[mut_idx] ^= random_pauli()\\n        \\n        if candidate_L[mut_idx] == 0 or len(E.gf2_basis(candidate_L)) != len_L:\\n            fails += 1\\n            if fails > 100:\\n                L = list(best_L)\\n                for _ in range(int(rng.integers(1, 3))):\\n                    idx = int(rng.integers(len_L))\\n                    L[idx] ^= random_pauli()\\n                if len(E.gf2_basis(L)) == len_L:\\n                    S = E.nullspace([E._J(v, n) for v in L], 2 * n)\\n                    cur = objective(E.evaluate(S))\\n                fails = 0\\n            continue\\n\\n        candidate_S = E.nullspace([E._J(v, n) for v in candidate_L], 2 * n)\\n        if len(candidate_S) != s:\\n            continue\\n\\n        res = E.evaluate(candidate_S)\\n        new_obj = objective(res)\\n        delta = new_obj - cur\\n\\n        if delta <= 0 or rng.random() < math.exp(-delta / temp):\\n            L, cur = candidate_L, new_obj\\n            fails = 0\\n            if cur < best_obj:\\n                best_obj = cur\\n                best_L = list(L)\\n        else:\\n            fails += 1\\n            if fails > 100:\\n                L = list(best_L)\\n                for _ in range(int(rng.integers(1, 3))):\\n                    idx = int(rng.integers(len_L))\\n                    L[idx] ^= random_pauli()\\n                if len(E.gf2_basis(L)) == len_L:\\n                    S = E.nullspace([E._J(v, n) for v in L], 2 * n)\\n                    cur = objective(E.evaluate(S))\\n                fails = 0\\n\\n    return None\"}",
