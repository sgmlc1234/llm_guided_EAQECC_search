n                \\n            eval_res = E.evaluate(cand_S)\\n            new_obj = objective(eval_res)\\n            \\n            if new_obj < best_obj:\\n                best_obj = new_obj\\n                best_S = cand_S\\n                if best_obj == 0:\\n                    return best_S\\n                \\n            diff = new_obj - cur_obj\\n            if diff <= 0 or rng.random() < math.exp(-diff / temp):\\n                cur_obj = new_obj\\n                fails = 0 if diff < 0 else fails + 1\\n            else:\\n                L[idx] = old_val\\n                fails += 1\\n                \\n    return best_S\"}",
