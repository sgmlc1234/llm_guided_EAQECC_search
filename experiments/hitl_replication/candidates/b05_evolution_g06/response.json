     continue\\n            \\n            cand_S = E.nullspace([E._J(v, n) for v in L], 2 * n)\\n            if len(cand_S) != s:\\n                L[idx] = old_val\\n                fails += 1\\n                continue\\n                \\n            new_obj = objective(E.evaluate(cand_S))\\n            diff = new_obj - cur_obj\\n            if diff <= 0 or rng.random() < math.exp(-diff / temp):\\n                cur_obj = new_obj\\n                fails = 0 if diff < 0 else fails + 1\\n            else:\\n                L[idx] = old_val\\n                fails += 1\\n    return None\"\n}",
