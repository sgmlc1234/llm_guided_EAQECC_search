            "text": "{\n  \"code\": \"import math\\n\\ndef search(target, max_evals):\\n    n, k, c = target[\\\"n\\\"], target[\\\"k\\\"], target[\\\"c\\\"]\\n    l = n + k - c\\n\\n    def objective(res):\\n        if res.get(\\\"offending\\\") is None or res.get(\\\"c\\\") is None:\\n            return 10**9\\n        return 5000 * abs(res[\\\"c\\\"] - c) + res[\\\"offending\\\"]\\n\\n    def get_S(L):\\n        rows = [E._J(v, n) for v in L]\\n        return list(E.nullspace(rows, 2 * n))\\n\\n    def random_vector():\\n        return int(rng.integers(1, 1 << (2 * n)))\\n\\n    while E.remaining:\\n        # Generate a valid initial L of rank l\\n        L = []\\n        while len(L) < l:\\n            v = random_vector()\\n            cand = L + [v]\\n            if len(E.gf2_basis(cand)) == len(cand):\\n                L.append(v)\\n        \\n        S = get_S(L)\\n        res = E.evaluate(S)\\n        cur = objective(res)\\n        \\n        temp, fails = 30.0, 0\\n        while fails < 1000 and E.remaining:\\n            temp = max(0.1, temp * 0.995)\\n            idx = int(rng.integers(l))\\n            old_v = L[idx]\\n            \\n            # Mutate: either completely random or small perturbation\\n            if rng.random() < 0.5:\\n                L[idx] = random_vector()\\n            else:\\n                L[idx] ^= random_vector()\\n                \\n            if len(E.gf2_basis(L)) != l:\\n                L[idx] = old_v\\n                fails += 1\\n                continue\\n                \\n            S = get_S(L)\\n            res = E.evaluate(S)\\n            new_obj = objective(res)\\n            delta = new_obj - cur\\n            \\n            if delta <= 0 or rng.random() < math.exp(-delta / temp):\\n                cur = new_obj\\n                fails = 0 if delta < 0 else fails + 1\\n            else:\\n                L[idx] = old_v\\n                fails += 1\\n                \\n    return None\"\n}",
