# Copy to .env and fill in. Both PROJECT_ID and GE_APP_ID are required by
# scripts/alphaevolve_eaqecc/run_evolution.py and have no defaults.
# See docs/alphaevolve_gcp_setup.md.

# Google Cloud project that is allowlisted for AlphaEvolve
PROJECT_ID=
# Discovery Engine engine ("app") id created in that project
GE_APP_ID=
LOCATION=global

# Generation models and their sampling weights
MODEL_1=gemini-3.5-flash
MODEL_1_WEIGHT=0.5
MODEL_2=gemini-3.1-pro-preview
MODEL_2_WEIGHT=0.5

# Campaign size and per-candidate search budget
MAX_PROGRAMS_GENERATED=120
MAX_PROGRAMS_EVALUATED=120
CONCURRENCY=4
WORKER_CONCURRENCY=4
SEARCH_BUDGET_S=240

# Path to a CaDiCaL binary, for the refutation claims (optional)
CADICAL_PATH=
